# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# City Configuration
CITY_CONFIG_PATH=config/city.yaml

# AI Provider: 'gemini' | 'ollama' | 'mock'
LLM_PROVIDER=mock

# Hosted Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Open-Weights Gemma / Ollama / vLLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OPEN_WEIGHTS_MODEL=gemma2:9b

# Speech-to-Text Provider: 'gemini' | 'whisper' | 'mock'
STT_PROVIDER=mock

# Storage & Database
DATABASE_URL=sqlite:///./pakka_hal.db
UPLOAD_DIR=./uploads

# Security & Privacy
ENABLE_EXIF_STRIPPING=true
ENABLE_HASH_CHAIN=true
HASH_CHAIN_SEED=pakka_hal_chandigarh_genesis_2026
 Wilson_INTERVAL_CONFIDENCE=0.95
